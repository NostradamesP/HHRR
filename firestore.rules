rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin(uid) {
      return signedIn()
        && hasUser(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "admin";
    }

    function isManager(uid) {
      return signedIn()
        && hasUser(uid)
        && (
          get(/databases/$(database)/documents/users/$(uid)).data.role in ["admin", "manager"]
          || get(/databases/$(database)/documents/users/$(uid)).data.jobTitle in ["IT Project Manager", "IT Manager", "Manager"]
        );
    }

    function boardDoc(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId));
    }

    function isBoardMember(boardId) {
      return signedIn() && request.auth.uid in boardDoc(boardId).data.members;
    }

    function isBoardOperator(boardId) {
      return isBoardMember(boardId)
        && (boardDoc(boardId).data.ownerId == request.auth.uid || isManager(request.auth.uid));
    }

    function validUserProfile(data) {
      return data.keys().hasOnly(["email", "name", "role", "jobTitle", "createdAt", "updatedAt"])
        && data.email == request.auth.token.email
        && data.name is string
        && (!("role" in data) || data.role in ["member", "manager", "admin"])
        && (!("jobTitle" in data) || data.jobTitle is string);
    }

    function validStoredUser(data) {
      return data.keys().hasOnly(["email", "name", "role", "jobTitle", "createdAt", "updatedAt"])
        && data.email is string
        && data.name is string
        && (!("role" in data) || data.role in ["member", "manager", "admin"])
        && (!("jobTitle" in data) || data.jobTitle is string);
    }

    function validBoard(data) {
      return data.keys().hasOnly(["name", "createdBy", "ownerId", "members", "createdAt", "updatedAt"])
        && data.name is string
        && data.createdBy is string
        && data.ownerId is string
        && data.members is list
        && data.members.size() > 0;
    }

    function validTask(data) {
      return data.keys().hasOnly([
          "title", "module", "phase", "priority", "effort", "description", "status", "order",
          "startDate", "dueDate", "archived", "assignedTo", "assignedName", "ticketType",
          "requester", "system", "impact", "urgency", "slaHours", "checklist",
          "operationalState", "blockedReason", "commentsCount", "createdBy", "createdAt", "updatedAt",
          "attachments"
        ])
        && data.title is string
        && data.status is string
        && (!("archived" in data) || data.archived is bool)
        && (!("order" in data) || data.order is number)
        && (!("commentsCount" in data) || data.commentsCount is number);
    }

    function validComment(data) {
      return data.keys().hasOnly(["text", "userId", "userName", "createdAt", "updatedAt"])
        && data.text is string
        && data.userId == request.auth.uid
        && data.userName is string;
    }

    function validMessage(data) {
      return data.keys().hasOnly(["text", "userId", "userName", "createdAt", "updatedAt"])
        && data.text is string
        && data.userId == request.auth.uid
        && data.userName is string;
    }

    function validLog(data) {
      return data.keys().hasOnly(["action", "taskId", "taskTitle", "details", "userId", "userName", "createdAt"])
        && data.action is string
        && data.taskId is string
        && data.userId == request.auth.uid
        && data.userName is string;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin(request.auth.uid));
      allow list: if signedIn() && isAdmin(request.auth.uid);
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserProfile(request.resource.data)
        && request.resource.data.role == "member";
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "jobTitle", "updatedAt"])
          && validStoredUser(request.resource.data)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email)
        || (isAdmin(request.auth.uid) && validStoredUser(request.resource.data))
      );
      allow delete: if signedIn() && isAdmin(request.auth.uid) && request.auth.uid != userId;
    }

    match /boards/{boardId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && validBoard(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isBoardOperator(boardId)
        && validBoard(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isBoardOperator(boardId);

      match /tasks/{taskId} {
        allow read: if isBoardMember(boardId);
        allow create: if isBoardOperator(boardId)
          && validTask(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isBoardMember(boardId)
          && validTask(request.resource.data)
          && (
            isBoardOperator(boardId)
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status", "operationalState", "order", "commentsCount", "updatedAt"
              ])
              && (
                resource.data.status in ["pending", "in_progress"]
                || request.resource.data.status == resource.data.status
              )
            )
          );
        allow delete: if isBoardOperator(boardId);

        match /comments/{commentId} {
          allow read: if isBoardMember(boardId);
          allow create: if isBoardMember(boardId) && validComment(request.resource.data);
          allow update: if isBoardMember(boardId)
            && resource.data.userId == request.auth.uid
            && validComment(request.resource.data);
          allow delete: if isBoardMember(boardId) && resource.data.userId == request.auth.uid;
        }
      }

      match /messages/{messageId} {
        allow read: if isBoardMember(boardId);
        allow create: if isBoardMember(boardId) && validMessage(request.resource.data);
        allow update: if isBoardMember(boardId)
          && resource.data.userId == request.auth.uid
          && validMessage(request.resource.data);
        allow delete: if isBoardMember(boardId) && resource.data.userId == request.auth.uid;
      }

      match /logs/{logId} {
        allow read: if isBoardMember(boardId);
        allow create: if isBoardMember(boardId) && validLog(request.resource.data);
        allow update: if false;
        allow delete: if isBoardOperator(boardId);
      }
    }

    match /tasks/{taskId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
